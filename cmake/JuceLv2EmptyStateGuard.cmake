function(duskstudio_guard_juce_lv2_empty_state)
    if(TARGET juce_audio_processors_headless)
        set(module juce_audio_processors_headless)
    else()
        set(module juce_audio_processors)
    endif()
    set(moduleDirectory "${DUSKSTUDIO_JUCE_SOURCE_DIR}/modules/${module}")
    get_filename_component(moduleDirectory "${moduleDirectory}" ABSOLUTE)
    set(stateFile "${moduleDirectory}/format_types/LV2_SDK/lilv/src/state.c")
    set(supportFile "${moduleDirectory}/format_types/juce_LV2SupportLibs.cpp")
    set(wrapperFile "${moduleDirectory}/${module}_lv2_libs.cpp")
    foreach(source IN ITEMS "${stateFile}" "${supportFile}" "${wrapperFile}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    endforeach()

    file(READ "${stateFile}" state)
    set(before "    } else {\n      qsort(state->props.props, state->props.n, sizeof(Property), property_cmp);")
    set(after "    } else if (state->props.props) {\n      qsort(state->props.props, state->props.n, sizeof(Property), property_cmp);")
    string(FIND "${state}" "${after}" guardedIndex)
    if(NOT guardedIndex LESS 0 AND NOT WIN32)
        return()
    endif()
    if(guardedIndex LESS 0)
        string(FIND "${state}" "${before}" originalIndex)
        if(originalIndex LESS 0)
            message(FATAL_ERROR "Unrecognized Lilv state sort in ${stateFile}; review the empty-state guard")
        endif()
        string(REPLACE "${before}" "${after}" state "${state}")
    endif()

    # Keep shared JUCE checkouts untouched; every consumer uses the guarded copy.
    set(copyDirectory "${CMAKE_CURRENT_BINARY_DIR}/juce-lv2-empty-state")
    file(MAKE_DIRECTORY "${copyDirectory}")
    set(stateCopy "${copyDirectory}/state.c")
    set(supportCopy "${copyDirectory}/juce_LV2SupportLibs.cpp")
    set(wrapperCopy "${copyDirectory}/${module}_lv2_libs.cpp")
    file(READ "${supportFile}" support)
    string(REPLACE "#include \"LV2_SDK/"
        "#include \"${moduleDirectory}/format_types/LV2_SDK/" support "${support}")
    if(WIN32)
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/JuceLv2WindowsPaths.cmake")
        duskstudio_juce_lv2_windows_paths("${moduleDirectory}" "${copyDirectory}")
    endif()
    file(CONFIGURE OUTPUT "${stateCopy}" CONTENT "${state}" @ONLY)
    set(stateInclude "#include \"lilv/src/state.c\"")
    string(FIND "${support}" "${stateInclude}" includeIndex)
    if(includeIndex LESS 0)
        message(FATAL_ERROR "Cannot locate the Lilv state include in ${supportFile}")
    endif()
    string(REPLACE "${stateInclude}" "#include \"${stateCopy}\"" support "${support}")
    file(CONFIGURE OUTPUT "${supportCopy}" CONTENT "${support}" @ONLY)

    file(READ "${wrapperFile}" wrapper)
    if(module STREQUAL "juce_audio_processors_headless")
        set(supportInclude "#include <${module}/format_types/juce_LV2SupportLibs.cpp>")
    else()
        set(supportInclude "#include \"format_types/juce_LV2SupportLibs.cpp\"")
    endif()
    string(FIND "${wrapper}" "${supportInclude}" includeIndex)
    if(includeIndex LESS 0)
        message(FATAL_ERROR "Cannot locate the LV2 support include in ${wrapperFile}")
    endif()
    string(REPLACE "${supportInclude}" "#include \"${supportCopy}\"" wrapper "${wrapper}")
    file(CONFIGURE OUTPUT "${wrapperCopy}" CONTENT "${wrapper}" @ONLY)

    get_target_property(sources ${module} INTERFACE_SOURCES)
    list(FIND sources "${wrapperFile}" wrapperIndex)
    if(wrapperIndex LESS 0)
        message(FATAL_ERROR "Cannot locate the LV2 module source to apply the empty-state guard")
    endif()
    list(REMOVE_AT sources ${wrapperIndex})
    list(INSERT sources ${wrapperIndex} "${wrapperCopy}")
    set_property(TARGET ${module} PROPERTY INTERFACE_SOURCES "${sources}")
    message(STATUS "Dusk Studio: guarded Lilv empty-state sort in the build tree")
endfunction()
