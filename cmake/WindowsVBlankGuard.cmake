function(duskstudio_guard_windows_vblank moduleDirectory)
    get_filename_component(moduleDirectory "${moduleDirectory}" ABSOLUTE)
    set(sourceFile "${moduleDirectory}/native/juce_VBlank_windows.cpp")
    file(READ "${sourceFile}" source)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sourceFile}")
    set(before "while (adapter->dxgiAdapter->EnumOutputs (i, output.resetAndGetPointerAddress()) != DXGI_ERROR_NOT_FOUND)")
    set(newline "\n")
    if(source MATCHES "\r\n")
        set(newline "\r\n")
    endif()
    set(after "while (SUCCEEDED (adapter->dxgiAdapter->EnumOutputs (i, output.resetAndGetPointerAddress()))${newline}                   && output != nullptr)")
    string(REPLACE "${before}" "" withoutBefore "${source}")
    string(REPLACE "${after}" "" withoutAfter "${source}")
    string(LENGTH "${source}" sourceLength)
    string(LENGTH "${withoutBefore}" withoutBeforeLength)
    string(LENGTH "${withoutAfter}" withoutAfterLength)
    string(LENGTH "${before}" beforeLength)
    string(LENGTH "${after}" afterLength)
    math(EXPR beforeCount "(${sourceLength} - ${withoutBeforeLength}) / ${beforeLength}")
    math(EXPR afterCount "(${sourceLength} - ${withoutAfterLength}) / ${afterLength}")
    if(beforeCount EQUAL 0 AND afterCount EQUAL 1)
        return()
    endif()
    if(NOT beforeCount EQUAL 1 OR NOT afterCount EQUAL 0)
        message(FATAL_ERROR "Unrecognized Windows VBlank enumeration in ${sourceFile}; review the DXGI output guard")
    endif()

    set(originalModule "${moduleDirectory}/juce_gui_basics.cpp")
    get_target_property(sources juce_gui_basics INTERFACE_SOURCES)
    list(FIND sources "${originalModule}" moduleIndex)
    if(moduleIndex LESS 0)
        message(FATAL_ERROR "Cannot locate the Windows GUI module source to apply the DXGI output guard")
    endif()

    # Other projects may share the dependency checkout.
    set(copyDirectory "${CMAKE_CURRENT_BINARY_DIR}/juce-windows-vblank")
    file(MAKE_DIRECTORY "${copyDirectory}/native")
    configure_file("${originalModule}" "${copyDirectory}/juce_gui_basics.cpp" COPYONLY)
    string(REPLACE "${before}" "${after}" guarded "${source}")
    set(guardedFile "${copyDirectory}/native/juce_VBlank_windows.cpp")
    set(existing "")
    if(EXISTS "${guardedFile}")
        file(READ "${guardedFile}" existing)
    endif()
    if(NOT existing STREQUAL guarded)
        file(WRITE "${guardedFile}" "${guarded}")
    endif()
    list(REMOVE_AT sources ${moduleIndex})
    list(INSERT sources ${moduleIndex} "${copyDirectory}/juce_gui_basics.cpp")
    set_property(TARGET juce_gui_basics PROPERTY INTERFACE_SOURCES "${sources}")
    target_include_directories(juce_gui_basics INTERFACE "${moduleDirectory}")
    message(STATUS "Dusk Studio: guarded Windows VBlank output enumeration in the build tree")
endfunction()
