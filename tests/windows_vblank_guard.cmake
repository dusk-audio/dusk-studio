cmake_minimum_required(VERSION 3.22)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${CMAKE_CURRENT_BINARY_DIR}/windows-vblank-${nonce}")
set(before "while (adapter->dxgiAdapter->EnumOutputs (i, output.resetAndGetPointerAddress()) != DXGI_ERROR_NOT_FOUND)")
set(after "while (SUCCEEDED (adapter->dxgiAdapter->EnumOutputs (i, output.resetAndGetPointerAddress()))\n                   && output != nullptr)")

function(checkFixture name input expectedPass expectedCopy)
    set(project "${root}/${name}")
    set(module "${project}/module")
    set(moduleArgument "${module}")
    if(name STREQUAL "alias")
        set(moduleArgument "${project}/child/../module")
    endif()
    file(MAKE_DIRECTORY "${module}/native")
    file(WRITE "${module}/native/juce_VBlank_windows.cpp" "${input}")
    file(SHA256 "${module}/native/juce_VBlank_windows.cpp" originalHash)
    file(WRITE "${module}/juce_gui_basics.cpp" "module source marker\n")
    set(projectTemplate [=[
cmake_minimum_required(VERSION 3.22)
project(GuardFixture NONE)
add_library(juce_gui_basics INTERFACE)
target_sources(juce_gui_basics INTERFACE "@module@/juce_gui_basics.cpp")
include("@REPO_ROOT@/cmake/WindowsVBlankGuard.cmake")
duskstudio_guard_windows_vblank("@moduleArgument@")
get_target_property(effective juce_gui_basics INTERFACE_SOURCES)
get_directory_property(watched CMAKE_CONFIGURE_DEPENDS)
file(WRITE "${CMAKE_BINARY_DIR}/effective.txt" "${effective}")
file(WRITE "${CMAKE_BINARY_DIR}/watched.txt" "${watched}")
]=])
    string(CONFIGURE "${projectTemplate}" projectSource @ONLY)
    file(WRITE "${project}/CMakeLists.txt" "${projectSource}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${project}" -B "${project}/build"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expectedPass AND NOT status EQUAL 0)
        message(FATAL_ERROR "${name} rejected a supported source: ${output}${error}")
    elseif(NOT expectedPass AND status EQUAL 0)
        message(FATAL_ERROR "${name} accepted an unrecognized enumeration")
    endif()
    if(NOT expectedPass AND NOT error MATCHES "Unrecognized Windows VBlank enumeration")
        message(FATAL_ERROR "${name} failed outside the enumeration guard: ${error}")
    endif()
    file(SHA256 "${module}/native/juce_VBlank_windows.cpp" currentHash)
    if(NOT currentHash STREQUAL originalHash)
        message(FATAL_ERROR "${name} changed the dependency checkout")
    endif()
    if(expectedPass)
        file(READ "${project}/build/watched.txt" watched)
        list(FIND watched "${module}/native/juce_VBlank_windows.cpp" watchedIndex)
        if(watchedIndex LESS 0)
            message(FATAL_ERROR "${name} does not reconfigure after dependency changes")
        endif()
        file(READ "${project}/build/effective.txt" effective)
        if(expectedCopy)
            set(copy "${project}/build/juce-windows-vblank")
            if(NOT effective STREQUAL "${copy}/juce_gui_basics.cpp")
                message(FATAL_ERROR "${name} did not select the guarded GUI module")
            endif()
            file(READ "${copy}/native/juce_VBlank_windows.cpp" guarded)
            string(REPLACE "\r\n" "\n" normalized "${guarded}")
            string(STRIP "${normalized}" normalized)
            if(NOT normalized STREQUAL after)
                message(FATAL_ERROR "${name} did not guard failed or null output enumeration")
            endif()
            execute_process(COMMAND "${CMAKE_COMMAND}" -S "${project}" -B "${project}/build"
                RESULT_VARIABLE repeated OUTPUT_QUIET ERROR_VARIABLE error)
            if(NOT repeated EQUAL 0)
                message(FATAL_ERROR "${name} failed when configured again: ${error}")
            endif()
        elseif(NOT effective STREQUAL "${module}/juce_gui_basics.cpp")
            message(FATAL_ERROR "${name} replaced an already guarded module")
        endif()
    endif()
endfunction()

checkFixture(original "${before}" TRUE TRUE)
checkFixture(alias "${before}" TRUE TRUE)
checkFixture(crlf "${before}\r\n" TRUE TRUE)
checkFixture(guarded "${after}" TRUE FALSE)
string(REPLACE "\n" "\r\n" guardedCrlf "${after}")
checkFixture(guarded_crlf "${guardedCrlf}" TRUE FALSE)
checkFixture(duplicate "${before}\n${before}" FALSE FALSE)
checkFixture(mixed "${before}\n${after}" FALSE FALSE)
checkFixture(unknown "while (anotherEnumeration())" FALSE FALSE)
file(REMOVE_RECURSE "${root}")
message(STATUS "Windows VBlank guard contract passed")
