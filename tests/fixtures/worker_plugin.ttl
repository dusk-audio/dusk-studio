@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .

<urn:duskstudio:test:worker>
    a lv2:Plugin ;
    doap:name "Dusk worker fixture" ;
    lv2:requiredFeature urid:map , work:schedule ;
    lv2:extensionData work:interface , state:interface ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 4 ; lv2:symbol "target" ; lv2:name "Target" ;
          lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 5 ; lv2:symbol "delay" ; lv2:name "Delay" ;
          lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 500.0 ;
          lv2:portProperty lv2:integer ] .

<urn:duskstudio:test:worker-unsupported>
    a lv2:Plugin ;
    doap:name "Dusk worker fixture (unsupported feature)" ;
    lv2:requiredFeature urid:map , work:schedule ,
        <urn:duskstudio:test:feature-dusk-studio-lacks> ;
    lv2:extensionData work:interface , state:interface ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 4 ; lv2:symbol "target" ; lv2:name "Target" ;
          lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 5 ; lv2:symbol "delay" ; lv2:name "Delay" ;
          lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 500.0 ;
          lv2:portProperty lv2:integer ] .

<urn:duskstudio:test:worker-hard-rt>
    a lv2:Plugin ;
    doap:name "Dusk worker fixture (lv2core properties and state paths as required features)" ;
    lv2:requiredFeature urid:map , work:schedule ,
        lv2:hardRTCapable , lv2:isLive , lv2:inPlaceBroken ,
        state:mapPath , state:makePath , state:freePath ;
    lv2:extensionData work:interface , state:interface ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output R" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 4 ; lv2:symbol "target" ; lv2:name "Target" ;
          lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 5 ; lv2:symbol "delay" ; lv2:name "Delay" ;
          lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 500.0 ;
          lv2:portProperty lv2:integer ] .
